                "1",
                "--use_wandb",
                "False",
                "--use_metadata",
                "True",
                "--input_dim",
                "38",
            ]
        } ,
    
        {
            "name": "DeepStateGNN debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": ["--device", "cuda", "--dataset", "SD", "--n_hid", "32", "--n_context", "100", "--n_context_emb", "128"]
        },
                {
            "name": "PDFormer debugger",
