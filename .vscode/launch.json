    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },

        {

            "name": "Debug: DCRNN",
            "type": "debugpy",
            "request": "launch",
            "program": "experiments/dcrnn/main.py",
            "console": "integratedTerminal",
            "args": [
                "--device",
                "cpu",
                "--dataset",
                "SD",
                "--years",
                "2019",
                "--seed",
                "2023",
                "--model_name",
                "dcrnn_tr_drop_025_01",
                "--max_epochs",
                "3",
                "--mask_name",
                "tr_drop_025",
                "--mask_iter",
                "0",
                "--use_wandb",
                "False",
            ]
        },{

