    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },

        {

            "name": "Debug: DCRNN",
            "type": "debugpy",
            "request": "launch",
            "program": "experiments/dcrnn/main.py",
            "console": "integratedTerminal",
            "args": [
                "--device",
                "cpu",
                "--dataset",
                "SD",
                "--years",
                "2019",
                "--seed",
                "2023",
                "--model_name",
                "dcrnn_tr_drop_025_01",
                "--max_epochs",
                "3",
                "--mask_name",
                "tr_drop_025",
                "--mask_iter",
                "0",
                "--use_wandb",
                "False",
            ]
        },{

            "name": "Debug: DSGNN",
            "type": "debugpy",
            "request": "launch",
            "program": "experiments/dsgnn/main.py",
            "console": "integratedTerminal",
            "args": [
                "--device",
                "mps",
                "--dataset",
                "SD",
                "--years",
                "2019",
                "--seed",
                "2023",
                "--model_name",
                "deepstategnn_tr_drop_025_00",
                "--max_epochs",
                "3",
                "--mask_name",
                "point_missing_095",
                "--mask_iter",
                "0",
                "--use_wandb",
                "False",
                "--use_metadata",
                "True",
                "--input_dim",
                "38",
            ]
        }  ,{

            "name": "Debug: OPCR",
            "type": "debugpy",
            "request": "launch",
            "program": "experiments/opcr/main.py",
            "console": "integratedTerminal",
            "args": [
                "--device",
                "cpu",
                "--dataset",
                "SD",
                "--years",
                "2019",
                "--seed",
                "2023",
                "--model_name",
                "opcr_tr_drop_025_00",
                "--mask_name",
                "point_missing_095",
                "--mask_iter",
                "0",                
                "--max_epochs",
                "3",
                "--use_wandb",
                "False",
                "--use_metadata",
                "True",
                "--train_data_percentage",
                "2",
                "--input_dim",
                "38",
